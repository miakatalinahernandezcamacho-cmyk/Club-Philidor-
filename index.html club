/* =========================================================
   CLUB PHILIDOR — script.js
========================================================= */

document.addEventListener('DOMContentLoaded', () => {

  /* ---------- NAVBAR: scroll + menú móvil ---------- */
  const navbar = document.getElementById('navbar');
  const navToggle = document.getElementById('navToggle');
  const navMenu = document.getElementById('navMenu');

  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 40);
  });

  navToggle.addEventListener('click', () => {
    const isOpen = navMenu.classList.toggle('open');
    navToggle.classList.toggle('active', isOpen);
    navToggle.setAttribute('aria-expanded', isOpen);
  });

  navMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      navMenu.classList.remove('open');
      navToggle.classList.remove('active');
      navToggle.setAttribute('aria-expanded', 'false');
    });
  });

  /* ---------- SCROLL REVEAL ---------- */
  const revealEls = document.querySelectorAll('.reveal');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  revealEls.forEach(el => revealObserver.observe(el));

  /* ---------- CONTADORES ANIMADOS ---------- */
  const counters = document.querySelectorAll('.stat__num[data-target]');
  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target;
      const target = parseInt(el.dataset.target, 10);
      const suffix = el.dataset.suffix || '';
      const duration = 1400;
      const start = performance.now();

      function tick(now) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.floor(eased * target) + suffix;
        if (progress < 1) requestAnimationFrame(tick);
        else el.textContent = target + suffix;
      }
      requestAnimationFrame(tick);
      counterObserver.unobserve(el);
    });
  }, { threshold: 0.5 });
  counters.forEach(el => counterObserver.observe(el));

  /* ---------- CUENTA REGRESIVA ---------- */
  // EDITAR: fecha del próximo torneo (año, mes-1, día, hora, minuto)
  const tournamentDate = new Date(2026, 8, 21, 14, 30, 0).getTime(); // 21 de septiembre de 2026, 2:30 PM

  const cdDays = document.getElementById('cd-days');
  const cdHours = document.getElementById('cd-hours');
  const cdMins = document.getElementById('cd-mins');
  const cdSecs = document.getElementById('cd-secs');

  function updateCountdown() {
    const now = new Date().getTime();
    const distance = tournamentDate - now;

    if (distance <= 0) {
      [cdDays, cdHours, cdMins, cdSecs].forEach(el => el.textContent = '00');
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const mins = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const secs = Math.floor((distance % (1000 * 60)) / 1000);

    cdDays.textContent = String(days).padStart(2, '0');
    cdHours.textContent = String(hours).padStart(2, '0');
    cdMins.textContent = String(mins).padStart(2, '0');
    cdSecs.textContent = String(secs).padStart(2, '0');
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);

  /* ---------- TABLERO INTERACTIVO ---------- */
  const board = document.getElementById('chessboard');

  const initialSetup = {
    0: { 0:'♜',1:'♞',2:'♝',3:'♛',4:'♚',5:'♝',6:'♞',7:'♜' },
    1: { 0:'♟',1:'♟',2:'♟',3:'♟',4:'♟',5:'♟',6:'♟',7:'♟' },
    6: { 0:'♙',1:'♙',2:'♙',3:'♙',4:'♙',5:'♙',6:'♙',7:'♙' },
    7: { 0:'♖',1:'♘',2:'♗',3:'♕',4:'♔',5:'♗',6:'♘',7:'♖' }
  };

  function pieceAt(row, col) {
    return (initialSetup[row] && initialSetup[row][col]) || '';
  }

  function isWhitePiece(p) {
    return ['♙','♖','♘','♗','♕','♔'].includes(p);
  }

  function knightMoves(row, col) {
    const deltas = [[-2,-1],[-2,1],[-1,-2],[-1,2],[1,-2],[1,2],[2,-1],[2,1]];
    return deltas
      .map(([dr, dc]) => [row + dr, col + dc])
      .filter(([r, c]) => r >= 0 && r < 8 && c >= 0 && c < 8);
  }

  function pawnMoves(row, col, white) {
    const dir = white ? -1 : 1;
    const moves = [[row + dir, col]];
    const startRow = white ? 6 : 1;
    if (row === startRow) moves.push([row + dir * 2, col]);
    return moves.filter(([r]) => r >= 0 && r < 8);
  }

  let selectedSquare = null;

  function clearHighlights() {
    board.querySelectorAll('.sq').forEach(sq => {
      sq.classList.remove('sq--selected', 'sq--move');
    });
  }

  function renderBoard() {
    board.innerHTML = '';
    for (let row = 0; row < 8; row++) {
      for (let col = 0; col < 8; col++) {
        const sq = document.createElement('div');
        const isLight = (row + col) % 2 === 0;
        sq.className = `sq ${isLight ? 'sq--light' : 'sq--dark'}`;
        sq.dataset.row = row;
        sq.dataset.col = col;
        sq.setAttribute('role', 'gridcell');

        const piece = pieceAt(row, col);
        if (piece) {
          sq.textContent = piece;
          sq.classList.add(isWhitePiece(piece) ? 'sq--white-piece' : 'sq--black-piece');
          sq.setAttribute('aria-label', `Pieza en fila ${row + 1}, columna ${col + 1}`);
          sq.tabIndex = 0;
        }

        sq.addEventListener('click', () => handleSquareClick(row, col, piece));
        board.appendChild(sq);
      }
    }
  }

  function handleSquareClick(row, col, piece) {
    clearHighlights();

    if (!piece) {
      selectedSquare = null;
      return;
    }

    selectedSquare = { row, col, piece };
    const squareEl = board.querySelector(`[data-row="${row}"][data-col="${col}"]`);
    squareEl.classList.add('sq--selected');

    let candidateMoves = [];
    const upper = piece;
    if (upper === '♘' || upper === '♞') {
      candidateMoves = knightMoves(row, col);
    } else if (upper === '♙' || upper === '♟') {
      candidateMoves = pawnMoves(row, col, isWhitePiece(piece));
    } else {
      // Para el resto de piezas mostramos una casilla hacia adelante como muestra simbólica
      const dir = isWhitePiece(piece) ? -1 : 1;
      candidateMoves = [[row + dir, col]].filter(([r]) => r >= 0 && r < 8);
    }

    candidateMoves.forEach(([r, c]) => {
      if (pieceAt(r, c)) return; // no mostramos casillas ocupadas como movimiento simple
      const target = board.querySelector(`[data-row="${r}"][data-col="${c}"]`);
      if (target) target.classList.add('sq--move');
    });
  }

  if (board) renderBoard();

  /* ---------- GALERÍA + FILTROS ---------- */
  const filterBtns = document.querySelectorAll('.filter-btn');
  const galleryItems = document.querySelectorAll('.gallery__item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;

      galleryItems.forEach(item => {
        const match = filter === 'todas' || item.dataset.cat === filter;
        item.classList.toggle('hidden', !match);
      });
    });
  });

  /* ---------- LIGHTBOX ---------- */
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg');
  const lightboxClose = document.getElementById('lightboxClose');
  const lightboxPrev = document.getElementById('lightboxPrev');
  const lightboxNext = document.getElementById('lightboxNext');

  let currentIndex = 0;
  function visibleItems() {
    return Array.from(galleryItems).filter(item => !item.classList.contains('hidden'));
  }

  function openLightbox(index) {
    const items = visibleItems();
    if (!items.length) return;
    currentIndex = index;
    lightboxImg.src = items[currentIndex].src;
    lightboxImg.alt = items[currentIndex].alt;
    lightbox.classList.add('active');
  }

  function closeLightbox() {
    lightbox.classList.remove('active');
  }

  galleryItems.forEach((item) => {
    item.addEventListener('click', () => {
      const items = visibleItems();
      const idx = items.indexOf(item);
      openLightbox(idx);
    });
  });

  lightboxClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  lightboxPrev.addEventListener('click', () => {
    const items = visibleItems();
    currentIndex = (currentIndex - 1 + items.length) % items.length;
    lightboxImg.src = items[currentIndex].src;
    lightboxImg.alt = items[currentIndex].alt;
  });

  lightboxNext.addEventListener('click', () => {
    const items = visibleItems();
    currentIndex = (currentIndex + 1) % items.length;
    lightboxImg.src = items[currentIndex].src;
    lightboxImg.alt = items[currentIndex].alt;
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') lightboxNext.click();
    if (e.key === 'ArrowLeft') lightboxPrev.click();
  });

  /* ---------- VALIDACIÓN DE FORMULARIO ---------- */
  const form = document.getElementById('joinForm');
  const formSuccess = document.getElementById('formSuccess');

  function showError(name, message) {
    const field = form.querySelector(`[name="${name}"]`);
    const errorEl = form.querySelector(`.error-msg[data-for="${name}"]`);
    field.closest('.form-group').classList.add('error');
    if (errorEl) errorEl.textContent = message;
  }

  function clearError(name) {
    const field = form.querySelector(`[name="${name}"]`);
    const errorEl = form.querySelector(`.error-msg[data-for="${name}"]`);
    field.closest('.form-group').classList.remove('error');
    if (errorEl) errorEl.textContent = '';
  }

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      formSuccess.textContent = '';
      let valid = true;

      const fullname = form.fullname.value.trim();
      const age = form.age.value.trim();
      const level = form.level.value;
      const phone = form.phone.value.trim();
      const email = form.email.value.trim();
      const city = form.city.value.trim();

      ['fullname', 'age', 'level', 'phone', 'email', 'city'].forEach(clearError);

      if (fullname.length < 3) {
        showError('fullname', 'Ingresa tu nombre completo.');
        valid = false;
      }

      if (!age || age < 4 || age > 99) {
        showError('age', 'Ingresa una edad válida.');
        valid = false;
      }

      if (!level) {
        showError('level', 'Selecciona tu nivel de juego.');
        valid = false;
      }

      const phonePattern = /^[0-9+\s-]{7,15}$/;
      if (!phonePattern.test(phone)) {
        showError('phone', 'Ingresa un teléfono válido.');
        valid = false;
      }

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(email)) {
        showError('email', 'Ingresa un correo electrónico válido.');
        valid = false;
      }

      if (city.length < 2) {
        showError('city', 'Ingresa tu ciudad.');
        valid = false;
      }

      if (valid) {
        formSuccess.textContent = `¡Gracias, ${fullname}! Hemos recibido tu solicitud y pronto te contactaremos.`;
        form.reset();
      }
    });
  }

});
